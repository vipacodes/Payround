# PayRound Environment Variables
# Copy to .env.local

# Owner Config
OWNER_EMAIL=vipacodes@gmail.com
OWNER_WHATSAPP=+2349151723199

# Bank Details - Owner can change in dashboard, these are defaults
NEXT_PUBLIC_OWNER_BANK_NAME=Palmpay
NEXT_PUBLIC_OWNER_ACCOUNT_NUMBER=9151723199
NEXT_PUBLIC_OWNER_ACCOUNT_NAME=Basikoro James Okeroghene
NEXT_PUBLIC_GROUP_CREATION_FEE=5000
NEXT_PUBLIC_RENEWAL_FEE=5000

# Ads Pricing
NEXT_PUBLIC_AD_1DAY=500
NEXT_PUBLIC_AD_1WEEK=3325
NEXT_PUBLIC_AD_1MONTH=13500

# Free Storage - Cloudinary (25GB free)
# Create free account at cloudinary.com and paste here
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=payround_unsigned
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Telegram Bot for Unlimited Backup (optional but recommended)
# Talk to @BotFather on Telegram, create bot, get token
# Create private channel, add bot as admin, get channel ID
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHANNEL_ID=@your_private_channel

# Database - Use Supabase free tier for production
# For now uses localStorage mock, but ready for Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp Business API (optional, for auto-send. If empty uses wa.me links free)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
